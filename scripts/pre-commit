#!/usr/bin/env bash
# Pre-commit hook для bsl-analyzer
# Автоматически запускает fmt и clippy перед коммитом

set -e

# Цвета
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit checks...${NC}\n"

# 1. Cargo fmt
echo -e "${YELLOW}[1/2] Checking code formatting...${NC}"
if ! cargo fmt --all -- --check; then
    echo -e "\n${RED}❌ Code formatting check failed!${NC}"
    echo -e "${YELLOW}Run: cargo fmt --all${NC}"
    echo -e "${YELLOW}Or add --no-verify to skip (not recommended)${NC}\n"
    exit 1
fi
echo -e "${GREEN}✓ Formatting OK${NC}\n"

# 2. Clippy
echo -e "${YELLOW}[2/2] Running clippy...${NC}"
if ! cargo clippy --all-targets --all-features -- -D warnings; then
    echo -e "\n${RED}❌ Clippy found issues!${NC}"
    echo -e "${YELLOW}Fix the issues above or add --no-verify to skip (not recommended)${NC}\n"
    exit 1
fi
echo -e "${GREEN}✓ Clippy OK${NC}\n"

echo -e "${GREEN}✓ All pre-commit checks passed!${NC}\n"
exit 0
