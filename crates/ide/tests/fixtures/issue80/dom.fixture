//- /valid.bsl
Функция СоздатьДокумент(ИспользоватьHTML)
    Если ИспользоватьHTML Тогда
        Возврат Новый ДокументHTML("issue80");
    КонецЕсли;
    Возврат Новый ДокументDOM("urn:issue80", "root");
КонецФункции

Процедура Воспроизвести(ИспользоватьHTML)
    Документ = СоздатьДокумент(ИспользоватьHTML);
    Дочерний = Документ.СоздатьЭлемент("child");
    Родитель = Новый ДокументDOM("urn:issue80", "parent");
    Родитель.ДобавитьДочерний(Дочерний);
КонецПроцедуры

//- /invalid.bsl
Процедура ВоспроизвестиКонтроль()
    Родитель = Новый ДокументDOM("urn:issue80", "parent");
    Родитель.ДобавитьДочерний(42);
КонецПроцедуры
