Процедура Тест()
	Запрос = "
		// Комментарий стоит вне строки запроса, между её частями.
		|ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.Характеристика КАК Характеристика,
		|	Остатки.Серия КАК Серия,
		|	Остатки.Склад КАК Склад,
		|	Остатки.КоличествоОстаток КАК Количество,
		|	ЕСТЬNULL(Ячейки.Код, """") КАК КодЯчейки,
		|	ЕСТЬNULL(Ячейки.Идентификатор, 0) КАК ИдентификаторЯчейки,
		|	ЕСТЬNULL(Партии.ДатаПоступления, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПоступления,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Партии.СрокГодности, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК СрокГодностиЗадан
		|ПОМЕСТИТЬ ОстаткиПоЯчейкам
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваров.Остатки(&Дата, ) КАК Остатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РазмещениеПоЯчейкам.СрезПоследних(, Склад = &Склад) КАК Ячейки
		|		ПО Остатки.Номенклатура = Ячейки.Номенклатура
		|			И Остатки.Склад = Ячейки.Склад
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПартиях.СрезПоследних(, ) КАК Партии
		|		ПО Остатки.Серия = Партии.Серия
		|;
		|
		// Вторая часть пакета читает временную таблицу и соединяет её с
		// прикладными справочниками. Комментарии между частями пакета —
		// то же самое место, где раньше возникало ложное срабатывание.
		|////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиПоЯчейкам.Номенклатура КАК Номенклатура,
		|	ОстаткиПоЯчейкам.Характеристика КАК Характеристика,
		|	ОстаткиПоЯчейкам.Серия КАК Серия,
		|	ОстаткиПоЯчейкам.Склад КАК Склад,
		|	ОстаткиПоЯчейкам.КодЯчейки КАК КодЯчейки,
		|	СУММА(ОстаткиПоЯчейкам.Количество) КАК Количество,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Виды.Наименование, """") = """"
		|			ТОГДА ""Не указан""
		|		ИНАЧЕ Виды.Наименование
		|	КОНЕЦ КАК ВидЗапаса,
		|	ВЫБОР
		|		КОГДА ОстаткиПоЯчейкам.СрокГодностиЗадан
		|				И ЕСТЬNULL(Партии.СрокГодности, ДАТАВРЕМЯ(1, 1, 1)) < &Дата
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СрокИстёк
		|ИЗ
		|	ОстаткиПоЯчейкам КАК ОстаткиПоЯчейкам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЗапасов КАК Виды
		|		ПО ОстаткиПоЯчейкам.Номенклатура = Виды.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПартиях.СрезПоследних(, ) КАК Партии
		|		ПО ОстаткиПоЯчейкам.Серия = Партии.Серия
		|ГДЕ
		|	ОстаткиПоЯчейкам.Количество > 0
		|	И НЕ ОстаткиПоЯчейкам.Номенклатура В (&ИсключаемаяНоменклатура)
		// Условие ниже закомментировано целиком вместе с вертикальными чертами.
		// Такая форма — комментарий, внутри которого лежит текст запроса, — и
		// есть то, что правило разбора запроса не должно принимать за запрос.
		//|	И ВЫБОР
		//|			КОГДА ОстаткиПоЯчейкам.Номенклатура В (&ОсобаяНоменклатура)
		//|				И НЕ Партии.СрокГодности ЕСТЬ NULL
		//|					ТОГДА Партии.СрокГодности <> НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		//|			ИНАЧЕ ИСТИНА
		//|	КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиПоЯчейкам.Номенклатура,
		|	ОстаткиПоЯчейкам.Характеристика,
		|	ОстаткиПоЯчейкам.Серия,
		|	ОстаткиПоЯчейкам.Склад,
		|	ОстаткиПоЯчейкам.КодЯчейки,
		|	ОстаткиПоЯчейкам.СрокГодностиЗадан,
		|	Виды.Наименование,
		|	Партии.СрокГодности
		// Порядок ниже тоже закомментирован построчно вместе с чертами.
		//|УПОРЯДОЧИТЬ ПО
		//|	Номенклатура,
		//|	Серия,
		//|	ВЫБОР
		//|		КОГДА ОстаткиПоЯчейкам.Склад = &ОсновнойСклад
		//|			ТОГДА 1
		//|		ИНАЧЕ 0
		//|	КОНЕЦ,
		//|	КодЯчейки
		|";

	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Склад", Справочники.Склады.ПустаяСсылка());
	Запрос.УстановитьПараметр("ОсновнойСклад", Справочники.Склады.ПустаяСсылка());
	Запрос.УстановитьПараметр("ИсключаемаяНоменклатура", Новый Массив);
	Запрос.УстановитьПараметр("ОсобаяНоменклатура", Новый Массив);

	Возврат Запрос.Выполнить().Выгрузить();

КонецПроцедуры
